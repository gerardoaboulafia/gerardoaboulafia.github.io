---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const all = await getCollection("projects");
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 6);

const posts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---
<BaseLayout title="Gerardo Aboulafia — Portfolio">
  <!-- HERO centrado con foto -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
    <img
      src="/me.png"
      alt="Portrait of Gerardo Aboulafia"
      class="mx-auto h-40 w-40 rounded-full object-cover ring-1 ring-slate-200 shadow-sm"
      width="160"
      height="160"
      loading="eager"
    />
    <h1 class="mt-6 text-4xl md:text-5xl font-serif font-bold">👋 Hi, I'm Gerardo</h1>

    <!-- About -->
    <p class="mt-6 md:mt-8 text-slate-700 dark:text-slate-300 max-w-2xl mx-auto">
      Data Architect at MetLife with a data engineering background (BigQuery, Airflow, Python), now focused on data governance and quality automation in Collibra, with growing experience in LLM APIs and applied machine learning. Data Science student at Universidad Católica Argentina — ranked top of my cohort four years running.
    </p>

    <!-- Contact -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-slate-700 dark:text-slate-300">
      <a
        href="mailto:gerardo.aboulafia18@gmail.com"
        class="inline-flex items-center gap-2 hover:underline"
      >
        <span aria-hidden="true">📧</span> gerardo.aboulafia18@gmail.com
      </a>
      <a
        href="https://www.linkedin.com/in/gerardoaboulafia/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 hover:underline"
      >
        <span aria-hidden="true">💼</span> LinkedIn
      </a>
    </div>
  </section>

  <!-- PROYECTOS (centrado) -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 text-center">
    <h2 class="text-xl font-semibold mb-6">Projects</h2>
    <div class="grid justify-center sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {featured.map((p) => (
        <ProjectCard
          href={`/projects/${p.slug}/`}
          title={p.data.title}
          year={p.data.year}
          summary={p.data.summary}
          stack={p.data.stack}
        />
      ))}
    </div>
    <div class="mt-6">
      <a class="underline" href="/projects/">View all projects</a>
    </div>
  </section>

  <!-- BLOG -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 text-center">
    <h2 class="text-xl font-semibold mb-6">Blog</h2>
    <ul class="space-y-6 text-left max-w-3xl mx-auto">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}/`} class="group block">
            <h3 class="text-base font-semibold group-hover:underline">{p.data.title}</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">{p.data.date}</p>
            <p class="text-slate-600 dark:text-slate-300 mt-1 text-sm">{p.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-6">
      <a class="underline" href="/blog/">View all posts</a>
    </div>
  </section>
</BaseLayout>
